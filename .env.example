# Default provider. Leave GROQ_API_KEY empty to run in clearly-labelled DEMO mode.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=          # optional: openrouter | xai

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b   # must be in your Groq account model list (GET /openai/v1/models)

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=

LLM_TIMEOUT_MS=30000
EMBEDDING_PROVIDER=keyword   # "local" embeddings are not implemented yet; keyword (BM25) fallback is used
